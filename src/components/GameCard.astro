---
import type { Game } from "../data/games";

interface Props {
  game: Game;
}

const { game } = Astro.props;
---

<a
  href={game.href}
  class="game-card"
  data-category={game.category}
  data-search={`${game.title} ${game.searchTerms ?? ""}`.toLowerCase()}
>
  <div class="card-image">
    <img src={game.icon} alt={game.title} width="200" height="200" loading="lazy" />
  </div>
  <div class="card-info">
    <span class="card-title">{game.caption}</span>
    <span class="card-category">{game.category}</span>
  </div>
</a>

<style>
  .game-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: all 0.25s ease;
    cursor: pointer;
  }

  .game-card:hover {
    transform: translateY(-6px);
    border-color: var(--accent);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.3), 0 0 0 1px var(--accent-glow);
  }

  .card-image {
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--bg-secondary);
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .game-card:hover .card-image img {
    transform: scale(1.08);
  }

  .card-info {
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .card-title {
    font-weight: 600;
    font-size: 0.9rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .card-category {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 500;
  }
</style>
