---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Changelog" description="See what updates we are making">
  <div class="changelog-page">
    <h1>Changelog</h1>
    <div class="widget-container">
      <widgetbot
        server="1095331543427334258"
        channel="1095523519971983380"
        width="100%"
        height="600"
      ></widgetbot>
      <script src="https://cdn.jsdelivr.net/npm/@widgetbot/html-embed"></script>
    </div>
  </div>
</BaseLayout>

<style>
  .changelog-page {
    max-width: 1000px;
    margin: 0 auto;
    padding: 48px 24px 80px;
  }

  h1 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 2.5rem;
    font-weight: 800;
    text-align: center;
    margin-bottom: 40px;
  }

  .widget-container {
    background: var(--bg-secondary);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    padding: 16px;
  }

  .widget-container :global(widgetbot) {
    border-radius: var(--radius-md);
  }
</style>
